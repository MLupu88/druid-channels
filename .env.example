# DRUID Channels & Alliances — production Docker Compose environment
#
# Copy to `.env` in the repository root (same directory as docker-compose.yml)
# and fill in real values. Never commit the resulting .env file.
#
#   docker compose --env-file .env config
#   docker compose --env-file .env up -d --build

# --- Required: database ---
# Connection string for the existing druid-channels-db container. Must
# resolve druid-channels-db:5432 over the shared druid-channels-internal
# Docker network (both app services join that network; the database and
# network are provisioned outside this compose file).
DATABASE_URL=postgres://user:password@druid-channels-db:5432/dbname

# --- Required: sessions ---
# Secret key used to sign session tokens (artifacts/api-server/src/services/session.ts).
SESSION_SECRET=

# --- Required if any Connection's secret is stored encrypted in the DB ---
# 32-byte AES-256-GCM key, encoded as exactly 64 hex characters, used to
# encrypt/decrypt DB-stored integration credentials (services/encryption.ts).
# Generate with: openssl rand -hex 32
# Missing or malformed fails closed: DB secrets become undecryptable rather
# than silently falling back to plaintext or a weaker key. Only required
# once an admin actually stores a secret via Admin > Connections & data --
# env-var-only credentials (SEARCH_API_KEY, AI_API_KEY, etc.) work without it.
INTEGRATION_ENCRYPTION_KEY=

# --- Required: Channel Chief machine-to-machine auth ---
# Bearer token for the Aniri/Channel Chief agent to call /api/channel-chief/*
# (see artifacts/api-server/src/middleware/channelChiefAuth.ts). This is a
# dedicated service-token secret, separate from human session login -- do
# not reuse SESSION_SECRET or any other secret for this value.
CHANNEL_CHIEF_API_TOKEN=

# --- CORS ---
# Origin allowed to call the API cross-origin in production.
CORS_ALLOWED_ORIGIN=https://channelsdruid.aiexperiments.eu

# --- API service (druid-channels-api) ---
# Port the API process listens on inside its own container.
API_PORT=8080
# Host bind address for the API container's published port. Defaults to
# loopback-only; change deliberately if it needs to be reachable beyond
# the host.
API_BIND_ADDRESS=127.0.0.1
# Host port to publish the API on. No default -- pick an unused port on the
# Hetzner server before deploying.
API_HOST_PORT=

# --- Web service (druid-channels-web) ---
# Build-time values baked into the static Vite bundle (see vite.config.ts).
WEB_BUILD_PORT=8080
WEB_BASE_PATH=/
# Host bind address for the web container's published port.
WEB_BIND_ADDRESS=127.0.0.1
# Host port to publish the web app on. No default -- pick an unused port on
# the Hetzner server before deploying.
WEB_HOST_PORT=

# --- Image tag ---
IMAGE_TAG=local

# --- Optional integrations (all read from Admin > Connections & data) ---
# Unconfigured sources are labeled NOT_CONNECTED in the UI; never fabricated.
HUBSPOT_ACCESS_TOKEN=
# SEARCH_PROVIDER powers live Channel Discovery search (services/discoveryProviders/search.ts).
# Supported value: tavily (Tavily Search API).
SEARCH_PROVIDER=
SEARCH_API_KEY=
# EXTRACTION_PROVIDER/EXTRACTION_API_KEY are unused by live Discovery today --
# Tavily's search result content flows directly through
# discoveryProviders/extraction.ts without a second external call.
EXTRACTION_PROVIDER=
EXTRACTION_API_KEY=
# AI_PROVIDER powers both the Overview AI Channel Brief (services/aiBriefProvider.ts)
# and Discovery evidence qualification (services/discoveryProviders/ai.ts).
# Supported value: deepseek (DeepSeek chat completions API).
AI_PROVIDER=
AI_API_KEY=

# --- Optional: Discovery tuning (services/discoveryBudget.ts) ---
# Number of ranked candidate entries a single Discovery scan sends to AI
# qualification (Stage 3's post-grouping/ranking cap, not raw search
# results). Unset or invalid -> defaults to 50. Never exceeds 100
# (MAX_CANDIDATES_TO_LLM_CEILING) regardless of what's set here, to bound
# worst-case per-run AI cost.
DISCOVERY_MAX_CANDIDATES_TO_LLM=
