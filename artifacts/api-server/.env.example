# DRUID Partner Radar Lite — API server environment variables
# Copy to .env and fill in real values outside of Replit. On Replit, set
# these via the Secrets tool instead of a .env file.

# --- Required ---
# PostgreSQL connection string. On Replit this is provisioned automatically.
DATABASE_URL=postgres://user:password@localhost:5432/partner_radar

# Port the API server listens on. Replit injects this automatically.
PORT=8080

# --- Optional integrations (Admin > Connections & data) ---
# Each connection in the app maps to one of these env vars. Metrics mapped
# to a source without its credential set will show as "Not connected" —
# they will never fall back to fabricated data.

# HubSpot private app access token (Settings > Integrations > Private Apps in HubSpot)
HUBSPOT_ACCESS_TOKEN=

# Web search provider (used for partner prospect discovery)
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Web content extraction/reader provider (used to read discovered pages)
EXTRACTION_PROVIDER=
EXTRACTION_API_KEY=

# AI provider used for scoring/summarizing prospects
AI_PROVIDER=
AI_API_KEY=

# Session secret (only needed if/when auth is added)
SESSION_SECRET=
