    "test:company-matching": "DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder tsx --test tests/companyMatching.test.ts",
    "test:portfolio-import-match-status": "DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder tsx --test tests/portfolioImportMatchStatus.test.ts",
    "test:radar-company-bridge": "DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder tsx --test tests/radarCompanyBridge.test.ts",
